# =============================================================================
# .env 样例
# -----------------------------------------------------------------------------
# 用法：
#   cp .env.example .env
# =============================================================================

# APISIX Admin API
APISIX_ADMIN_URL=http://apisix:9180

# APISIX Admin Key
APISIX_ADMIN_KEY=

# Redis（auth.lua 使用该密码查询用户登录凭据）
REDIS_URL=redis
REDIS_PORT=6379
REDIS_AUTH_PASSWORD=

# 服务间安全（与后端 Nacos 配置中的 from-source-secret 保持一致）
FROM_SOURCE_SECRET=

# 可选服务路由开关
DEPLOY_DOCS_ROUTE=true
DEPLOY_AI_ASSET_ROUTE=true
DEPLOY_DOCUMENT_ROUTE=true
DEPLOY_NOTE_ROUTE=true

# 前端静态站点 upstream
FRONTEND_HOST=
FRONTEND_PORT=8085

# 前端 OTLP HTTP 入口（APISIX -> Collector）
# APISIX 需要与 Collector 处于同一容器网络，默认使用 docker compose 服务名
OTEL_COLLECTOR_HOST=otel-collector
OTEL_COLLECTOR_PORT=4318

# CORS 正则（可选）
# 留空时 setup.sh 会读 defaults/cors-allow-origins.json
# CORS_REGEX_JSON='["^https?://localhost(:\\d+)?$"]'
